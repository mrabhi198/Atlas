# Atlas Backend — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# NOTE: The application still boots without these values using unsafe
# fallback defaults (intended for local prototype use only). Set strong
# secrets before any non-local deployment.

# Server
PORT=5001
# Frontend origin used for OAuth redirects and dev email links
FRONTEND_URL=http://localhost:5173

# JWT Secrets (REQUIRED for production — use long random strings)
ACCESS_TOKEN_SECRET=change_me_long_random_string
REFRESH_TOKEN_SECRET=change_me_long_random_string
SESSION_SECRET=change_me_long_random_string

# Google OAuth (optional — local email/password auth works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# GitHub OAuth (optional — local email/password auth works without it)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# Google Gemini AI (optional — mentor falls back to static replies without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_SYSTEM_INSTRUCTION=You are Cognitive Guide, AI mentor for Atlas...